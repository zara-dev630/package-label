{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "api/index.cjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/**", "server/models/best.onnx"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.cjs" }
  ]
}
